{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://reclaim-backend-9aa3.onrender.com/api/:path*"
    },
    {
      "source": "/sanctum/:path*",
      "destination": "https://reclaim-backend-9aa3.onrender.com/sanctum/:path*"
    },
    {
      "source": "/((?!api(?:/|$)|sanctum(?:/|$)|assets(?:/|$)|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/sanctum/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
